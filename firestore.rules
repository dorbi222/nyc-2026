rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function sessionPath() { return /databases/$(database)/documents/sessions/$(request.auth.uid); }
    function hasSession() { return signedIn() && exists(sessionPath()); }
    function me() { return get(sessionPath()).data.profile; }
    function is(list) { return hasSession() && me() in list; }
    function setupDone() { return exists(/databases/$(database)/documents/meta/setup); }

    // הגדרה ראשונה ומשתמשים
    match /meta/setup {
      allow read: if signedIn();
      allow create: if signedIn() && !setupDone();
    }
    match /users/{p} {
      allow read: if false;
      allow create: if (signedIn() && p in ['dor', 'moti', 'ben'] && !setupDone())
                    || (p == 'sydney' && is(['dor']));
    }

    // כניסה: רק עם קוד נכון
    match /sessions/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.profile in ['dor', 'moti', 'ben', 'sydney']
        && request.resource.data.pinHash == get(/databases/$(database)/documents/users/$(request.resource.data.profile)).data.pinHash;
    }

    // הטיול של שלושתנו: סידני רואה, לא עורכת
    match /brothers_items/{id} {
      allow read: if is(['dor', 'moti', 'ben', 'sydney']);
      allow write: if is(['dor', 'moti', 'ben']);
    }
    match /expenses/{id} { allow read, write: if is(['dor', 'moti', 'ben']); }

    // בוסטון: מוטי ובן עורכים, סידני רואה, דור לא
    match /boston_items/{id} {
      allow read: if is(['moti', 'ben', 'sydney']);
      allow write: if is(['moti', 'ben']);
    }
    match /boston_expenses/{id} { allow read, write: if is(['moti', 'ben']); }

    // MBA: רק דור
    match /mba_items/{id} { allow read, write: if is(['dor']); }

    match /settings/{id} { allow read: if hasSession(); allow write: if is(['dor']); }
    match /migrations/{id} { allow read: if hasSession(); allow write: if is(['dor', 'moti', 'ben']); }
    match /personal/{owner}/{coll}/{id} { allow read, write: if hasSession() && me() == owner; }
  }
}
